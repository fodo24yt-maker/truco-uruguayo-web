<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Lo que se cambió respecto de lo que genera Capacitor, y por qué:

      · `fullBackupContent` / `dataExtractionRules` — la copia de seguridad de
        Android es lo ÚNICO que hace que la gira sobreviva a cambiar de
        teléfono, porque no hay servidor donde guardar nada. Desde API 31
        declarar las reglas es obligatorio si la copia está prendida.
      · `usesCleartextTraffic="false"` — con `targetSdk` 36 ya es el valor por
        omisión; se escribe igual para que se vea que es una decisión y no un
        descuido. La app no le habla a nadie: todo sale de adentro del APK.
      · `screenOrientation="portrait"` — la app es de celular y sólo de celular.
        De paso evita que `lib/pantalla.ts` salte del diseño de celular al de PC
        en medio de una mano, que es lo que pasaría al girar el teléfono.
    -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
